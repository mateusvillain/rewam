{
  "name": "rewam",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma pessoal para registrar filmes e s\u00e9ries assistidos (Web, Android, iOS).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:test:rls": "docker exec -i supabase_db_rewam psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/tests/rls.sql"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "supabase": "^2.114.0",
    "turbo": "^2.5.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
