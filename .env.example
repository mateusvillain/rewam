# ---------------------------------------------------------------------------
# Variáveis públicas (embarcadas no bundle Expo — nunca colocar segredos aqui)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Token de leitura (v4) do TMDB, destinado a clientes.
EXPO_PUBLIC_TMDB_READ_TOKEN=

# ---------------------------------------------------------------------------
# Somente servidor (MCP / Edge Functions) — jamais expor ao app ou ao modelo
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_READ_TOKEN=

# SMTP do Resend, lido por supabase/config.toml em `supabase config push`.
# A senha é a API key do Resend (formato `re_...`), com permissão de envio.
SUPABASE_AUTH_SMTP_PASSWORD=
# Remetente dos e-mails de código. Precisa ser de um domínio verificado no
# Resend — antes disso, o envio só chega ao e-mail dono da conta.
# Hoje aponta para um domínio pessoal temporário, até o domínio do produto ser
# comprado; a troca está registrada na REW-52.
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=
